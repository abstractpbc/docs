{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "aspen",
	"name": "Abstract",
	"description": "One API for robot action models and LLMs.",
	"colors": {
		"primary": "#D6005A",
		"light": "#FD0365",
		"dark": "#D6005A"
	},
	"logo": {
		"light": "/logo/light.svg",
		"dark": "/logo/dark.svg"
	},
	"favicon": "/favicon.png",
	"fonts": {
		"heading": {
			"family": "Geist",
			"weight": 600
		},
		"body": {
			"family": "Geist",
			"weight": 400
		}
	},
	"icons": {
		"library": "lucide"
	},
	"appearance": {
		"default": "dark"
	},
	"background": {
		"color": {
			"light": "#FFFFFF",
			"dark": "#0B0B0E"
		}
	},
	"styling": {
		"eyebrows": "section"
	},
	"search": {
		"prompt": "Search the docs"
	},
	"contextual": {
		"options": ["copy", "view"]
	},
	"navbar": {
		"links": [
			{
				"label": "Pricing",
				"href": "https://abstract.inc/pricing"
			},
			{
				"label": "Platform",
				"href": "https://platform.abstract.inc"
			}
		],
		"primary": {
			"type": "button",
			"label": "Get started",
			"href": "https://abstract.inc/start"
		}
	},
	"navigation": {
		"tabs": [
			{
				"tab": "Guides",
				"icon": "book-open",
				"groups": [
					{
						"group": "Get started",
						"pages": ["index", "quickstart", "authentication"]
					},
					{
						"group": "Robot models",
						"pages": [
							"robots/models",
							"robots/chat-completions",
							"robots/sessions",
							"robots/handoff",
							"robots/usage"
						]
					},
					{
						"group": "LLM models",
						"pages": ["llm/responses"]
					},
					{
						"group": "Reference",
						"pages": ["errors", "cli"]
					}
				]
			},
			{
				"tab": "API reference",
				"icon": "square-terminal",
				"openapi": "api-reference/openapi.yaml",
				"groups": [
					{
						"group": "Overview",
						"pages": ["api-reference/introduction"]
					},
					{
						"group": "Robot models",
						"pages": ["POST /v1/chat/completions"]
					},
					{
						"group": "Robot runs",
						"pages": [
							"GET /v1/robot/runs",
							"GET /v1/robot/runs/usage",
							"GET /v1/robot/runs/{robot}/{run}",
							"DELETE /v1/robot/runs/{robot}/{run}",
							"POST /v1/robot/runs/{robot}/{run}/complete",
							"PUT /v1/robot/runs/{robot}/{run}/files/{path}",
							"GET /v1/robot/runs/{robot}/{run}/files/{path}",
							"DELETE /v1/robot/runs/{robot}/{run}/files/{path}",
							"GET /v1/robot/runs/{robot}/{run}/uploads/{path}",
							"POST /v1/robot/runs/{robot}/{run}/uploads/{path}",
							"PUT /v1/robot/runs/{robot}/{run}/uploads/{path}",
							"DELETE /v1/robot/runs/{robot}/{run}/uploads/{path}"
						]
					},
					{
						"group": "LLM models",
						"pages": ["POST /v1/responses", "GET /v1/responses/{response_id}", "GET /v1/models"]
					}
				]
			}
		]
	},
	"api": {
		"playground": {
			"display": "simple",
			"proxy": false
		},
		"examples": {
			"languages": ["curl", "python"]
		}
	},
	"footer": {
		"links": [
			{
				"header": "Product",
				"items": [
					{
						"label": "Pricing",
						"href": "https://abstract.inc/pricing"
					},
					{
						"label": "Platform",
						"href": "https://platform.abstract.inc"
					}
				]
			},
			{
				"header": "Company",
				"items": [
					{
						"label": "Blog",
						"href": "https://abstract.inc/blog"
					},
					{
						"label": "Careers",
						"href": "https://abstract.inc/careers"
					}
				]
			},
			{
				"header": "Legal",
				"items": [
					{
						"label": "Terms",
						"href": "https://abstract.inc/terms"
					},
					{
						"label": "Privacy",
						"href": "https://abstract.inc/privacy"
					}
				]
			}
		]
	}
}
